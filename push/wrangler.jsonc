// The planner push Worker. Not part of the Pages build (the build only reads src/).
// Secrets, set with `wrangler secret put` (see README.md): VAPID_PRIVATE, TEST_TOKEN.
{
	"name": "planner-push",
	"main": "index.js",
	"compatibility_date": "2026-11-01",
	"workers_dev": true,
	// Keep console output in Workers Logs; leave request details (invocation logs) off.
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": false
		}
	},
	// Hourly, UTC. The Worker sends only to phones whose local hour is their chosen hour.
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	"kv_namespaces": [
		// Fill `id` with the value `wrangler kv namespace create SUBS` prints.
		{
			"binding": "SUBS",
			"id": "5eabff73dd044df8ac191329fe587cdf"
		}
	],
	"vars": {
		// Contact for the push service: a URL or mailto: (Apple accepts either). The app's own address keeps email out of it.
		"VAPID_SUBJECT": "https://samfeldstein.github.io/planner/",
		// The public key `make-keys.mjs` prints; the same value goes in src/js/features/badge.js.
		"VAPID_PUBLIC": "BOsBIC0ZdInIfH-DPkm9Akx-ZI4J044roPI6yukcZi6BPbLnb7sih3K4pc15Q9wFRAQOm6GWEYnjZ8DOeXv3xWw"
	}
}